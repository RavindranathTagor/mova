{
  "name": "mova-outcome-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n agent,web \"node --watch --env-file=.env server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file=.env server/index.mjs",
    "test": "node --test tests",
    "test:graph": "node --test tests/graph.test.mjs",
    "mcp": "node --env-file=.env server/mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@remotion/player": "^4.0.534",
    "@xyflow/react": "^12.10.0",
    "express": "^5.1.0",
    "falkordb": "^6.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.534",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
