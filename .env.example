# Copy to .env. Only GOOGLE_MAPS_WEB_API_KEY is sent to the browser.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Configured live stack: Kiro and TomTom routes on OpenStreetMap display.
LLM_PROVIDER=kiro-cli
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Kiro CLI provider. Kiro Pro API keys authenticate the CLI, not a generic REST endpoint.
# Set LLM_PROVIDER=kiro-cli and install/authenticate the Kiro CLI before using this option.
KIRO_API_KEY=
KIRO_MODEL=claude-haiku-4.5
# Optional executable override when kiro-cli is not available on PATH.
KIRO_CLI_PATH=kiro-cli
MAPS_PROVIDER=tomtom
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_USER_AGENT=MOVA-LocalPrototype/0.1 (+https://localhost)
# Self-hosted Traccar. A numeric device ID and credentials enable polling.
TRACCAR_URL=http://127.0.0.1:8082
TRACCAR_DEVICE_ID=
TRACCAR_TOKEN=
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
TRACCAR_POLL_INTERVAL_MS=15000
# Set to 0.0.0.0 only when accepting your phone on a trusted LAN.
TRACCAR_INGEST_BIND=127.0.0.1
# Optional providers below
GEMINI_API_KEY=

#use groq
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_WEB_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
GOOGLE_CALENDAR_WRITE_ENABLED=false
# URL is the sole source of FalkorDB credentials; avoid duplicate username/password.
FALKORDB_URL=redis://127.0.0.1:6380
FALKORDB_GRAPH_NAME=mova
APP_SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
MOVA_DATA_DIR=.data
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Read-only context sources. Add only public or data you own, and list every channel explicitly.
MOVA_GRAPH_DATA_ATTESTATION=public_or_owned
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=RavindranathTagor/Agents-Playground,RavindranathTagor/slate-pad
GITHUB_MENTION_HANDLE=mova
SLACK_BOT_TOKEN=
SLACK_ALLOWED_CHANNEL_IDS=C0CA3PEVBAL
SLACK_BOT_USER_ID=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=1559991811965984890
DISCORD_BOT_USER_ID=
MOVA_MENTION_POLL_SECONDS=45
MOVA_MENTION_MAX_AGE_MINUTES=10
GMAIL_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
LOG_LEVEL=INFO
# TomTom traffic-aware routes; server-side credential only.
TOMTOM_API_KEY=
# Optional Kiro CLI decision window in milliseconds (30,000–110,000).
MOVA_KIRO_TIMEOUT_MS=90000
